{
  "name": "setup-anvil",
  "description": "Set up Anvil in GitHub Actions with automatic provider dependencies",
  "version": "1.0.0",
  "author": "JSChronicles",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/JSChronicles/setup-anvil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JSChronicles/setup-anvil.git"
  },
  "bugs": {
    "url": "https://github.com/JSChronicles/setup-anvil/issues"
  },
  "keywords": [
    "actions",
    "anvil",
    "github-actions"
  ],
  "exports": {
    "./setup": "./dist/setup/index.js",
    "./shim": "./dist/shim/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "bundle": "npm run format:write && npm run build",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package": "npm run build",
    "package:watch": "npm run build -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest",
    "typecheck": "tsc --noEmit",
    "all": "npm run format:write && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "rollup": "^4.57.1",
    "ts-jest": "^29.4.12",
    "ts-jest-resolver": "^2.0.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
